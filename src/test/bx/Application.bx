class {
    this.name = "bxxtdb-tests";
    this.datasources.xtdb = {
        driver: "xtdb",
        connectionString: getSystemSetting("XTDB_JDBC_URL", "jdbc:xtdb://localhost:5432/xtdb"),
        username: getSystemSetting("XTDB_USER", "xtdb"),
        password: getSystemSetting("XTDB_PASSWORD", "xtdb"),
        maxConnections: 3
    };
    this.datasource = "xtdb";
    // A distinct pool proves visibility after synchronous commit across connections.
    this.datasources.xtdbReader = duplicate(this.datasources.xtdb);
    this.datasources.xtdbReader.maxConnections = 1;
}
